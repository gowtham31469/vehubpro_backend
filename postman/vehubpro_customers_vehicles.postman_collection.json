{
  "info": {
    "name": "VeHubPro — Customers & Vehicles",
    "_postman_id": "c4b8f210-9a1d-4d6e-8c2f-1a2b3c4d5e6f",
    "description": "Customers, vehicle brands, vehicle models, and service vehicles. Tenant-scoped routes use JWT (tenant_id from token). Do not send tenant or tenant_id in the body for tenant-scoped APIs. Customer state/city are UUIDs from masters. Service vehicles use `/api/v1/vehicles/` (root); brands and models are under `/api/v1/vehicles/brands/` and `/api/v1/vehicles/models/`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Customers",
      "item": [
        {
          "name": "List Customers",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{base_url}}/api/v1/customers/?page=1&page_size=10&is_archive=false"
          }
        },
        {
          "name": "Create Customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"John Doe\",\n  \"email\": \"john.doe@example.com\",\n  \"phone\": \"+919876543210\",\n  \"alternate_phone\": \"+919876543211\",\n  \"address\": \"12 Beach Road\",\n  \"city\": \"{{city_id}}\",\n  \"state\": \"{{state_id}}\",\n  \"postal_code\": \"600001\",\n  \"status\": \"active\",\n  \"notes\": \"VIP customer\"\n}"
            },
            "url": "{{base_url}}/api/v1/customers/"
          }
        },
        {
          "name": "Get Customer",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{base_url}}/api/v1/customers/{{customer_id}}/"
          }
        },
        {
          "name": "Update Customer (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"John Doe Updated\",\n  \"email\": \"john.updated@example.com\",\n  \"phone\": \"+919876543210\",\n  \"alternate_phone\": \"+919876543211\",\n  \"address\": \"45 Lake View\",\n  \"city\": \"{{city_id}}\",\n  \"state\": \"{{state_id}}\",\n  \"postal_code\": \"560001\",\n  \"status\": \"active\",\n  \"notes\": \"Updated notes\"\n}"
            },
            "url": "{{base_url}}/api/v1/customers/{{customer_id}}/"
          }
        },
        {
          "name": "Patch Customer",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"inactive\",\n  \"notes\": \"Temporarily inactive\"\n}"
            },
            "url": "{{base_url}}/api/v1/customers/{{customer_id}}/"
          }
        },
        {
          "name": "Delete Customer (Archive)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{base_url}}/api/v1/customers/{{customer_id}}/"
          }
        }
      ]
    },
