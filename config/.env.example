# Core
DJANGO_ENV=dev
DJANGO_SETTINGS_MODULE=core.settings.dev
SECRET_KEY=replace-with-secure-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# Database (PostgreSQL)
DB_NAME=vehubpro
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Cache / async placeholders
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=1

# PII encryption key rotation (Fernet keys)
PII_ENCRYPTION_KEYS=v1:replace-with-generated-fernet-key,v2:replace-with-generated-fernet-key
PII_ACTIVE_KEY=v1

# Compliance placeholders
GDPR_DPDP_ENABLED=False
ISO27001_CONTROLS_ENABLED=False
CONSENT_AUDIT_TRAIL_REQUIRED=False

# CORS placeholder
CORS_ALLOWED_ORIGINS=http://localhost:3000
